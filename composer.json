{
    "name": "gonzalolopezgonzalez/mcp-readme-generator",
    "description": "MCP Server que genera README.md de proyectos PHP",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "mcp/sdk": "^0.1",
        "symfony/finder": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Gonzalolopezgonzalez\\McpReadmeGenerator\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Gonzalo López",
            "email": "lopezgonzalez@hotmail.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
